{
  "name": "sfvga-platform",
  "private": true,
  "version": "0.1.0",
  "description": "SFVGA Community Operating System — monorepo",
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/start-web.mjs",
    "dev:web": "node scripts/start-web.mjs",
    "test:payments:ui": "node scripts/start-payment-test.mjs",
    "test:security-rules": "firebase emulators:exec --only firestore,storage 'node scripts/test-security-rules.mjs'",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "bootstrap:admin": "node scripts/bootstrap-dev-admin.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "firebase-tools": "15.30.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "overrides": {
      "proxy-addr": "^2.0.8",
      "shell-quote": "^1.11.0"
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
