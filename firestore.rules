rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        (request.auth.token.get('superAdmin', false) == true ||
          (request.auth.token.get('role', '') == "admin" && request.auth.token.get('adminLevel', '') == "super"));
    }

    function legacyOrganizationPermission(permission) {
      return isSignedIn() && request.auth.token.get('role', '') == 'admin' &&
        !exists(/databases/$(database)/documents/organizationAdminGrants/$(request.auth.uid)) &&
        ((request.auth.token.get('adminLevel', '') == 'org' &&
          permission in ['events.view', 'events.edit', 'registrations.view', 'registrations.manage', 'tickets.scan', 'staff.view', 'members.view']) ||
         (request.auth.token.get('adminLevel', '') == 'content' &&
          permission in ['announcements.view', 'announcements.create', 'announcements.edit', 'announcements.delete', 'gallery.view', 'gallery.manage', 'members.view']) ||
         (request.auth.token.get('adminLevel', '') == 'finance' &&
          permission in ['registrations.view', 'members.view']));
    }

    function hasOrganizationPermission(permission) {
      return isSuperAdmin() || legacyOrganizationPermission(permission) ||
        (isSignedIn() &&
          exists(/databases/$(database)/documents/organizationAdminGrants/$(request.auth.uid)) &&
          exists(/databases/$(database)/documents/adminRoleDefinitions/$(get(/databases/$(database)/documents/organizationAdminGrants/$(request.auth.uid)).data.roleId)) &&
          get(/databases/$(database)/documents/adminRoleDefinitions/$(get(/databases/$(database)/documents/organizationAdminGrants/$(request.auth.uid)).data.roleId)).data.active == true &&
          !('deletedAt' in get(/databases/$(database)/documents/adminRoleDefinitions/$(get(/databases/$(database)/documents/organizationAdminGrants/$(request.auth.uid)).data.roleId)).data) &&
          permission in get(/databases/$(database)/documents/adminRoleDefinitions/$(get(/databases/$(database)/documents/organizationAdminGrants/$(request.auth.uid)).data.roleId)).data.permissions);
    }

    function hasEventPermission(eventId, permission) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/events/$(eventId)/roles/$(request.auth.uid)) &&
        exists(/databases/$(database)/documents/events/$(eventId)/roleDefinitions/$(get(/databases/$(database)/documents/events/$(eventId)/roles/$(request.auth.uid)).data.roleDefinitionId)) &&
        !('revokedAt' in get(/databases/$(database)/documents/events/$(eventId)/roles/$(request.auth.uid)).data) &&
        get(/databases/$(database)/documents/events/$(eventId)/roleDefinitions/$(get(/databases/$(database)/documents/events/$(eventId)/roles/$(request.auth.uid)).data.roleDefinitionId)).data.active == true &&
        !('deletedAt' in get(/databases/$(database)/documents/events/$(eventId)/roleDefinitions/$(get(/databases/$(database)/documents/events/$(eventId)/roles/$(request.auth.uid)).data.roleDefinitionId)).data) &&
        request.time >= get(/databases/$(database)/documents/events/$(eventId)/roles/$(request.auth.uid)).data.activatesAt &&
        request.time <= get(/databases/$(database)/documents/events/$(eventId)/roles/$(request.auth.uid)).data.expiresAt &&
        permission in get(/databases/$(database)/documents/events/$(eventId)/roleDefinitions/$(get(/databases/$(database)/documents/events/$(eventId)/roles/$(request.auth.uid)).data.roleDefinitionId)).data.permissions;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isActiveOwner(uid) {
      return isOwner(uid) &&
        exists(/databases/$(database)/documents/users/$(uid)) &&
        !('deletionRequestedAt' in get(/databases/$(database)/documents/users/$(uid)).data);
    }

    // A member editing their own profile may only touch low-risk fields — never role,
    // adminLevel, or membership (privilege escalation). Those are set server-side only
    // (onUserCreated / auth_setAdminRole, which run with the Admin SDK and bypass rules).
    function ownerSafeUserUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['displayName', 'photoUrl', 'email', 'notificationPrefs', 'expoPushTokens', 'fcmTokens', 'updatedAt', 'legalAcceptance'])
        && (!changed.hasAny(['legalAcceptance']) ||
          (!('legalAcceptance' in resource.data) &&
            request.resource.data.legalAcceptance.keys().hasOnly(['termsVersion', 'privacyVersion', 'acceptedAt']) &&
            request.resource.data.legalAcceptance.termsVersion == '2026-11-13' &&
            request.resource.data.legalAcceptance.privacyVersion == '2026-11-13' &&
            request.resource.data.legalAcceptance.acceptedAt == request.time))
        && (resource.data.displayName != '' || request.resource.data.displayName == '' ||
          'legalAcceptance' in request.resource.data);
    }

    // First-login client fallback when auth_onUserCreated is delayed/unavailable.
    // Locks role to member and forbids adminLevel so privilege cannot be self-granted.
    function isValidInitialMemberProfile() {
      let data = request.resource.data;
      return data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/accountDeletionJobs/$(request.auth.uid))
        && data.role == 'member'
        && data.displayName == ''
        && !('adminLevel' in data)
        && data.keys().hasOnly([
          'uid', 'displayName', 'phone', 'email', 'photoUrl', 'role',
          'membership', 'notificationPrefs', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'uid', 'displayName', 'phone', 'role', 'membership',
          'notificationPrefs', 'createdAt', 'updatedAt'
        ])
        && data.membership.keys().hasAll(['id', 'status', 'expiresAt'])
        && data.membership.status in ['active', 'expired']
        && data.notificationPrefs.keys().hasAll(['announcements', 'eventReminders']);
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || hasOrganizationPermission('members.view');
      // Prefer auth_onUserCreated (Admin SDK) for provisioning. Owners may also create
      // their own initial member profile once so first login works before Functions deploy.
      allow create: if isOwner(uid) && isValidInitialMemberProfile();
      allow delete: if false;
      allow update: if isActiveOwner(uid) && ownerSafeUserUpdate();

      match /notifications/{noticeId} {
        allow read: if isSignedIn() && isActiveOwner(uid);
        allow write: if false;
      }

      match /adminNotifications/{noticeId} {
        function canReadAdminNotice() {
          return isSignedIn() && isOwner(uid) &&
            (resource.data.type == 'admin_photo_album_reminder'
              ? ((hasOrganizationPermission('events.view') || hasEventPermission(resource.data.eventId, 'events.view')) &&
                 (hasOrganizationPermission('events.edit') || hasEventPermission(resource.data.eventId, 'events.edit')))
              : ((hasOrganizationPermission('registrations.view') || hasEventPermission(resource.data.eventId, 'registrations.view')) &&
                 (hasOrganizationPermission('registrations.manage') || hasEventPermission(resource.data.eventId, 'registrations.manage'))));
        }
        allow read: if canReadAdminNotice();
        allow update: if canReadAdminNotice() &&
          ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']) &&
            request.resource.data.readAt == request.time) ||
           (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dismissedAt']) &&
            request.resource.data.dismissedAt == request.time));
        allow create, delete: if false;
      }

      match /familyMembers/{memberId} {
        allow read, write: if isActiveOwner(uid);
      }
    }

    match /adminRoleDefinitions/{roleId} {
      allow read: if isSuperAdmin() || hasOrganizationPermission('members.view');
      allow write: if false;
    }

    match /organizationAdminGrants/{uid} {
      allow read: if isOwner(uid) || isSuperAdmin();
      allow write: if false;
    }

    match /adminAuditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update: if false; // Validated event callables only.
      allow delete: if false; // events_delete validates permissions and cleans nested data.

      match /registrations/{regId} {
        allow read: if isSignedIn() &&
          ((resource.data.userId == request.auth.uid && isActiveOwner(request.auth.uid)) ||
            hasOrganizationPermission('registrations.view') ||
            hasEventPermission(eventId, 'registrations.view'));

        allow create, update: if false; // Payment and completion are server-only.

        allow delete: if false; // Event deletion and registration transitions are server-only.

        match /messages/{messageId} {
          allow read: if isSignedIn() &&
            ((get(/databases/$(database)/documents/events/$(eventId)/registrations/$(regId)).data.userId == request.auth.uid && isActiveOwner(request.auth.uid)) ||
             hasOrganizationPermission('registrations.manage') || hasEventPermission(eventId, 'registrations.manage'));
          allow write: if false;
        }

        match /tickets/{ticketId} {
          // Owners + admins; any signed-in user may read for check-in until
          // tickets_validate (Admin SDK) is deployed on Blaze.
          allow read: if isSignedIn() &&
            (hasOrganizationPermission('registrations.view') ||
              hasEventPermission(eventId, 'registrations.view') ||
              (get(/databases/$(database)/documents/events/$(eventId)/registrations/$(regId)).data.userId
                == request.auth.uid && isActiveOwner(request.auth.uid)));

          allow create, update: if false; // Minting and redemption are server-only.

          allow delete: if false; // Event deletion and ticket lifecycle are server-only.
        }
      }

      match /roles/{roleId} {
        allow read: if isSignedIn() &&
          ((resource.data.userId == request.auth.uid && isActiveOwner(request.auth.uid)) ||
            hasOrganizationPermission('staff.view') ||
            hasEventPermission(eventId, 'staff.view'));
        allow write: if false;
      }

      match /roleDefinitions/{roleId} {
        allow read: if isSignedIn();
        allow write: if false;
      }

      match /announcements/{announcementId} {
        allow read: if isSignedIn();
        allow create, update: if false; // Validated callable only.
        allow delete: if hasOrganizationPermission('announcements.delete') || hasEventPermission(eventId, 'announcements.delete');
      }
    }

    match /roleDefinitions/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /announcements/{id} {
      allow read: if isSignedIn();
      allow create, update: if false; // Validated callable only.
      allow delete: if hasOrganizationPermission('announcements.delete') ||
        (resource.data.eventId is string && hasEventPermission(resource.data.eventId, 'announcements.delete'));
    }

    match /gallery/{albumId} {
      allow read: if isSignedIn();

      match /photos/{photoId} {
        allow read: if isSignedIn();
        allow create: if false; // Gallery uploads are not implemented yet.
        allow update, delete: if hasOrganizationPermission('gallery.manage');
      }
    }

    match /documentLibrary/{id} {
      allow read: if isSignedIn();
      allow write: if false; // Document uploads are not implemented yet.
    }

    match /feedback/{id} {
      allow read: if isSuperAdmin();
      allow create: if false; // Feedback submission is not implemented yet.
      allow update, delete: if false;
    }

    // Collection-group reads (e.g. my registrations / my staff roles across events).
    match /{path=**}/registrations/{regId} {
      allow read: if isSignedIn() &&
        ((resource.data.userId == request.auth.uid && isActiveOwner(request.auth.uid)) || hasOrganizationPermission('registrations.view'));
    }

    match /{path=**}/roles/{roleId} {
      allow read: if isSignedIn() &&
        ((resource.data.userId == request.auth.uid && isActiveOwner(request.auth.uid)) || hasOrganizationPermission('staff.view'));
    }

    match /{path=**}/tickets/{ticketId} {
      // Collection-group queries must be constrained to the scanner's authorized event.
      allow read: if isSignedIn() &&
        (hasOrganizationPermission('registrations.view') || hasOrganizationPermission('tickets.scan') ||
         hasEventPermission(resource.data.eventId, 'registrations.view') ||
         hasEventPermission(resource.data.eventId, 'tickets.scan'));
    }
  }
}
