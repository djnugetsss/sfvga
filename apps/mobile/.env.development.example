# Firebase — development project
# Copy to .env.development and fill in values from Firebase Console

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Admin dashboard (Next.js). Used by Profile → Admin dashboard.
# Local: http://localhost:3000   Android emulator: http://10.0.2.2:3000
EXPO_PUBLIC_ADMIN_WEB_URL=http://localhost:3000
