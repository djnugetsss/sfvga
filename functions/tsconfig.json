{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "lib",
    "rootDir": "src",
    "noEmit": false,
    "declaration": false,
    "declarationMap": false,
    "noImplicitReturns": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2022"
  },
  "compileOnSave": true,
  "include": ["src"]
}
