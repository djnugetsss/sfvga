# Runtime parameters for the Functions emulator.
# Copy to .env.local. Firebase defineSecret values belong in .secret.local instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SFVGA Tickets <tickets@sfvga.org>

# DEV_BOOTSTRAP_SECRET is a Firebase Secret Manager value, never a dotenv value.
# Set it with: firebase functions:secrets:set DEV_BOOTSTRAP_SECRET
